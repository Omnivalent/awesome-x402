# Copy to .env and adjust.

# Server
PORT=3000

# Admin token guarding market creation / lock / settle / void.
# CHANGE THIS before exposing the server.
ADMIN_TOKEN=dev-admin-token

# Payment mode:
#   simulation     -> no chain, no funds move (default, great for dev/demo)
#   devnet         -> real Solana devnet (free SOL via airdrop)
#   testnet
#   mainnet-beta   -> real money. Don't, without legal review.
#   https://your-rpc -> any custom RPC endpoint URL
PAYMENT_MODE=simulation

# Escrow keypair for live modes. Either provide a base58 secret key here,
# or leave blank and a keypair file is generated at data/.escrow.json on first
# run (you must then fund that address). Keep this secret — it controls the pot.
# ESCROW_SECRET_KEY=
# ESCROW_KEY_PATH=./data/.escrow.json

# Default fee schedule (per-market overridable). Basis points: 100 = 1%.
SLOT_PRICE_SOL=1
ENTRY_FEE_BPS=250      # 2.5% taken on every buy
CASHOUT_FEE_BPS=500    # 5% taken on cash-out / sell
RAKE_BPS=0             # house cut of the pot at settlement

# Where the JSON store lives.
DATA_PATH=./data/store.json
